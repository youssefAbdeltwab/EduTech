@{
    ViewData["Title"] = "لوحة التحكم";

    int totalStudents = ViewBag.TotalStudents;
    int paidCount = ViewBag.PaidCount;
    int unpaidCount = ViewBag.UnpaidCount;
    int currentMonth = ViewBag.CurrentMonth;
    int currentYear = ViewBag.CurrentYear;
    var courses = ViewBag.Courses as List<DAL.Entities.Course>;
    var failingStudents = ViewBag.FailingStudents as List<(DAL.Entities.Student Student, List<DAL.Entities.StudentExam> LastExams)>;
    double paidPercent = totalStudents > 0 ? Math.Round((double)paidCount / totalStudents * 100) : 0;
}

<!-- بطاقات الإحصائيات -->
<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card text-center p-4 border-0 shadow-sm">
            <div class="mb-2">
                <i class="bi bi-people-fill fs-1 text-primary"></i>
            </div>
            <h5 class="text-muted">إجمالي الطلاب</h5>
            <h2 class="fw-bold">@totalStudents</h2>
            <a asp-controller="Student" asp-action="Index" class="btn btn-outline-primary btn-sm mt-2">
                عرض الطلاب
            </a>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-center p-4 border-0 shadow-sm">
            <div class="mb-2">
                <i class="bi bi-check-circle-fill fs-1 text-success"></i>
            </div>
            <h5 class="text-muted">دفعوا هذا الشهر</h5>
            <h2 class="fw-bold text-success">@paidCount</h2>
            <a asp-controller="Payment" asp-action="Index"
               asp-route-month="@currentMonth" asp-route-year="@currentYear"
               class="btn btn-outline-success btn-sm mt-2">
                عرض القائمة
            </a>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-center p-4 border-0 shadow-sm">
            <div class="mb-2">
                <i class="bi bi-x-circle-fill fs-1 text-danger"></i>
            </div>
            <h5 class="text-muted">لم يدفعوا هذا الشهر</h5>
            <h2 class="fw-bold text-danger">@unpaidCount</h2>
            <a asp-controller="Payment" asp-action="Index"
               asp-route-month="@currentMonth" asp-route-year="@currentYear"
               class="btn btn-outline-danger btn-sm mt-2">
                عرض القائمة
            </a>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-center p-4 border-0 shadow-sm">
            <div class="mb-2">
                <i class="bi bi-journal-bookmark-fill fs-1 text-info"></i>
            </div>
            <h5 class="text-muted">الدورات</h5>
            <h2 class="fw-bold">@(courses?.Count ?? 0)</h2>
            <a asp-controller="Course" asp-action="Index" class="btn btn-outline-info btn-sm mt-2">
                عرض الدورات
            </a>
        </div>
    </div>
</div>

<!-- ملخص الدفع -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white">
        <i class="bi bi-bar-chart-fill text-primary"></i> ملخص الدفع - شهر @currentMonth / @currentYear
    </div>
    <div class="card-body">
        <div class="d-flex justify-content-between mb-2">
            <span>نسبة التحصيل</span>
            <span class="fw-bold">@paidPercent%</span>
        </div>
        <div class="progress" style="height: 25px;">
            <div class="progress-bar bg-success" role="progressbar" style="width: @paidPercent%">
                @paidCount دفعوا
            </div>
            <div class="progress-bar bg-danger" role="progressbar" style="width: @(100 - paidPercent)%">
                @unpaidCount لم يدفعوا
            </div>
        </div>
    </div>
</div>

<!-- الدورات -->
@if (courses != null && courses.Any())
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white">
            <i class="bi bi-journal-bookmark-fill text-info"></i> الدورات
        </div>
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>اسم الدورة</th>
                        <th>الوصف</th>
                        <th>عدد الطلاب</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var course in courses)
                    {
                        <tr>
                            <td>@course.CourseName</td>
                            <td>@(course.Description ?? "—")</td>
                            <td>
                                <span class="badge bg-primary rounded-pill">
                                    @(course.Students?.Count ?? 0)
                                </span>
                            </td>
                            <td>
                                <a asp-controller="Course" asp-action="Details" asp-route-id="@course.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- طلاب راسبون في آخر 5 امتحانات -->
@if (failingStudents != null && failingStudents.Any())
{
    <div class="card border-0 shadow-sm mb-4 border-start border-danger border-3">
        <div class="card-header bg-white">
            <i class="bi bi-exclamation-triangle-fill text-danger"></i>
            <span class="fw-bold text-danger">طلاب راسبون في آخر 5 امتحانات</span>
            <span class="badge bg-danger rounded-pill ms-2">@failingStudents.Count</span>
        </div>
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>كود الطالب</th>
                        <th>اسم الطالب</th>
                        <th>الدورة</th>
                        <th>آخر 5 درجات</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var (student, lastExams) in failingStudents)
                    {
                        <tr>
                            <td><strong>@student.StudentCode</strong></td>
                            <td>@student.FullName</td>
                            <td>@(student.Course?.CourseName ?? "—")</td>
                            <td>
                                @foreach (var se in lastExams)
                                {
                                    <span class="badge bg-danger me-1" title="@se.Exam?.ExamName">
                                        @se.Score / @se.Exam?.MaxScore
                                    </span>
                                }
                            </td>
                            <td>
                                <a asp-controller="Student" asp-action="Details" asp-route-id="@student.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- وصول سريع -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white">
        <i class="bi bi-lightning-fill text-warning"></i> وصول سريع
    </div>
    <div class="card-body">
        <div class="d-flex gap-3 flex-wrap">
            <a asp-controller="Student" asp-action="Create" class="btn btn-success">
                <i class="bi bi-person-plus"></i> إضافة طالب
            </a>
            <a asp-controller="Course" asp-action="Create" class="btn btn-info text-white">
                <i class="bi bi-journal-plus"></i> إضافة دورة
            </a>
            <a asp-controller="Exam" asp-action="Create" class="btn btn-warning text-white">
                <i class="bi bi-file-earmark-plus"></i> إضافة امتحان
            </a>
            <a asp-controller="Payment" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-cash-stack"></i> المدفوعات
            </a>
        </div>
    </div>
</div>
