@model IEnumerable<Student>

@{
    ViewData["Title"] = "الطلاب";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0"><i class="bi bi-people"></i> قائمة الطلاب</h4>
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> إضافة طالب
    </a>
</div>

<!-- Search -->
<div class="card mb-3">
    <div class="card-body py-2">
        <form asp-action="Index" method="get" class="d-flex align-items-center gap-2">
            <label class="form-label mb-0 fw-bold">بحث:</label>
            <input type="text" name="search" value="@ViewData["Search"]" class="form-control" style="max-width: 250px;" placeholder="كود الطالب أو الاسم" />
            <button type="submit" class="btn btn-primary btn-sm">
                <i class="bi bi-search"></i> بحث
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-x-circle"></i> مسح
            </a>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.StudentCode)</th>
                        <th>@Html.DisplayNameFor(model => model.FullName)</th>
                        <th>الدورة</th>
                        <th>@Html.DisplayNameFor(model => model.Phone)</th>
                        <th>@Html.DisplayNameFor(model => model.Email)</th>
                        <th>@Html.DisplayNameFor(model => model.Gender)</th>
                        <th>العمليات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                                لا يوجد طلاب حالياً
                            </td>
                        </tr>
                    }
                    @{ int counter = 0; }
                    @foreach (var item in Model)
                    {
                        counter++;
                        <tr>
                            <td><strong>@item.StudentCode</strong></td>
                            <td>@item.FullName</td>
                            <td>@(item.Course?.CourseName ?? "—")</td>
                            <td>@item.Phone</td>
                            <td>@item.Email</td>
                            <td>
                                @if (item.Gender == DAL.Enums.Gender.Male)
                                {
                                    <span class="badge bg-primary">ذكر</span>
                                }
                                else
                                {
                                    <span class="badge bg-info">أنثى</span>
                                }
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="تفاصيل">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning" title="تعديل">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="حذف">
                                    <i class="bi bi-trash"></i>
                                </a>
                                @if (!string.IsNullOrEmpty(item.Phone))
                                {
                                    var phone = item.Phone.TrimStart('+').Replace(" ", "").Replace("-", "");
                                    var msg = System.Net.WebUtility.UrlEncode($"مرحباً {item.FullName} \n،  م. أحمد عبستار نود تذكيرك بسداد رسوم شهر ");
                                    <a href="https://wa.me/@phone?text=@msg" target="_blank" class="btn btn-sm btn-success" title="تذكير بالدفع عبر واتساب">
                                        <i class="bi bi-whatsapp"></i>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
