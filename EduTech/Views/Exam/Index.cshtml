@model IEnumerable<Exam>

@{
    ViewData["Title"] = "الامتحانات";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0"><i class="bi bi-clipboard-check"></i> قائمة الامتحانات</h4>
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> إضافة امتحان
    </a>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>@Html.DisplayNameFor(model => model.ExamName)</th>
                        <th>@Html.DisplayNameFor(model => model.Course)</th>
                        <th>@Html.DisplayNameFor(model => model.ExamDate)</th>
                        <th>@Html.DisplayNameFor(model => model.MaxScore)</th>
                        <th>عدد الطلاب</th>
                        <th>العمليات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                                لا يوجد امتحانات حالياً
                            </td>
                        </tr>
                    }
                    @{ int counter = 0; }
                    @foreach (var item in Model)
                    {
                        counter++;
                        <tr>
                            <td>@counter</td>
                            <td><strong>@item.ExamName</strong></td>
                            <td>@(item.Course?.CourseName ?? "—")</td>
                            <td>@item.ExamDate.ToString("yyyy-MM-dd")</td>
                            <td>@item.MaxScore</td>
                            <td><span class="badge bg-secondary">@item.StudentExams.Count</span></td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="تفاصيل والدرجات">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning" title="تعديل">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="حذف">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
