@model ErrorViewModel
@{
    ViewData["Title"] = "خطأ";
    Layout = "_Layout";

    string icon, title, message, badgeClass;

    switch (Model.StatusCode)
    {
        case 404:
            icon = "bi-search";
            title = "الصفحة غير موجودة";
            message = "عذراً، الصفحة التي تبحث عنها غير موجودة أو تم نقلها.";
            badgeClass = "bg-warning text-dark";
            break;
        case 403:
            icon = "bi-shield-lock";
            title = "غير مصرح";
            message = "عذراً، ليس لديك صلاحية للوصول إلى هذه الصفحة.";
            badgeClass = "bg-danger";
            break;
        case 500:
            icon = "bi-exclamation-triangle";
            title = "خطأ في الخادم";
            message = "عذراً، حدث خطأ غير متوقع. يرجى المحاولة مرة أخرى لاحقاً.";
            badgeClass = "bg-danger";
            break;
        default:
            icon = "bi-exclamation-circle";
            title = "حدث خطأ";
            message = "عذراً، حدث خطأ أثناء معالجة طلبك.";
            badgeClass = "bg-secondary";
            break;
    }
}

<div class="d-flex justify-content-center align-items-center" style="min-height: 60vh;">
    <div class="text-center">
        <div class="mb-4">
            <i class="bi @icon text-danger" style="font-size: 5rem;"></i>
        </div>

        <span class="badge @badgeClass fs-6 mb-3">@Model.StatusCode</span>

        <h2 class="fw-bold mb-3">@title</h2>
        <p class="text-muted fs-5 mb-4">@message</p>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger text-start mx-auto" style="max-width: 500px;">
                <i class="bi bi-info-circle"></i> @Model.ErrorMessage
            </div>
        }

        @if (Model.ShowRequestId)
        {
            <p class="text-muted small mb-4">
                <strong>معرّف الطلب:</strong> <code>@Model.RequestId</code>
            </p>
        }

        <div class="d-flex gap-3 justify-content-center">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-house"></i> الصفحة الرئيسية
            </a>
            <button onclick="history.back()" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-right"></i> العودة للخلف
            </button>
        </div>
    </div>
</div>
