@model Expense
@using DAL.Entities

@{
    ViewData["Title"] = "إضافة مصروف";
}

<div class="mb-4">
    <h4><i class="bi bi-cash-stack"></i> إضافة مصروف جديد</h4>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Amount" class="form-label"></label>
                    <input asp-for="Amount" class="form-control" placeholder="0.00" />
                    <span asp-validation-for="Amount" class="field-validation-error"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Category" class="form-label"></label>
                    <select asp-for="Category" asp-items="ViewBag.Categories" class="form-select">
                        <option value="">-- اختر التصنيف --</option>
                    </select>
                    <span asp-validation-for="Category" class="field-validation-error"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Date" class="form-label"></label>
                    <input asp-for="Date" class="form-control" type="date" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="Date" class="field-validation-error"></span>
                </div>

                <div class="col-md-12 mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="أدخل وصف المصروف (اختياري)"></textarea>
                    <span asp-validation-for="Description" class="field-validation-error"></span>
                </div>
            </div>

            <hr />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-check-circle"></i> حفظ
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-right"></i> رجوع
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
